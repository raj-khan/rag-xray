# Copy to .env (Docker reads it) or export these in your shell.
# Nothing set = everything runs locally on Ollama, free and offline.

# ---------- Embeddings (search) ----------
# EMBED_PROVIDER=ollama            # ollama | openai (any OpenAI-compatible API)
# EMBED_MODEL=nomic-embed-text
# EMBED_BASE_URL=http://localhost:11434
# EMBED_API_KEY=

# ---------- Chat (answers) ----------
# CHAT_PROVIDER=ollama             # ollama | openai | anthropic
# CHAT_MODEL=llama3.2
# CHAT_BASE_URL=http://localhost:11434
# CHAT_API_KEY=

# ---------- Recipes (uncomment one block) ----------

# OpenAI for both
# EMBED_PROVIDER=openai
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Claude for answers, local embeddings
# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (OpenAI-compatible endpoint)
# CHAT_PROVIDER=openai
# CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_MODEL=gemini-2.5-flash
# CHAT_API_KEY=...

# OpenRouter (hundreds of models behind one key)
# CHAT_PROVIDER=openai
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
# CHAT_API_KEY=sk-or-...

# Groq (very fast hosted open models)
# CHAT_PROVIDER=openai
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile
# CHAT_API_KEY=gsk_...

# LM Studio or llama.cpp server running locally
# CHAT_PROVIDER=openai
# CHAT_BASE_URL=http://localhost:1234/v1
# CHAT_MODEL=your-loaded-model
